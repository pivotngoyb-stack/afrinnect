{
  "name": "AmbassadorContentAsset",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Asset name"
    },
    "description": {
      "type": "string"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "script",
        "hook",
        "brand_guide",
        "banner",
        "story_template"
      ],
      "indexed": true
    },
    "file_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "content_text": {
      "type": "string",
      "description": "For scripts/hooks - the actual text"
    },
    "campaign_id": {
      "type": "string",
      "description": "Associated campaign if any"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "download_count": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "asset_type"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}