{
  "name": "PhoneVerification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User being verified"
    },
    "phone_number": {
      "type": "string",
      "description": "Phone number to verify"
    },
    "verification_code": {
      "type": "string",
      "description": "6-digit code"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "Verification status"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Code expiry time"
    },
    "attempts": {
      "type": "number",
      "default": 0,
      "description": "Verification attempts"
    }
  },
  "required": [
    "user_id",
    "phone_number"
  ]
}