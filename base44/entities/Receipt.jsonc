{
  "name": "Receipt",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string",
      "description": "Unique transaction identifier"
    },
    "user_profile_id": {
      "type": "string",
      "description": "User who made the purchase"
    },
    "subscription_id": {
      "type": "string",
      "description": "Related subscription ID"
    },
    "plan_name": {
      "type": "string",
      "description": "Subscription plan name"
    },
    "billing_period": {
      "type": "string",
      "description": "Billing period (monthly, yearly, etc)"
    },
    "amount_paid": {
      "type": "number",
      "description": "Amount paid"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "Currency code"
    },
    "regional_discount": {
      "type": "boolean",
      "default": false,
      "description": "Regional discount applied"
    },
    "payment_provider": {
      "type": "string",
      "description": "Payment provider used"
    },
    "customer_email": {
      "type": "string",
      "description": "Customer email"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer name"
    },
    "purchase_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date of purchase"
    },
    "subscription_start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Subscription start date"
    },
    "subscription_end_date": {
      "type": "string",
      "format": "date-time",
      "description": "Subscription end date"
    },
    "receipt_sent": {
      "type": "boolean",
      "default": false,
      "description": "Receipt email sent"
    }
  },
  "required": [
    "transaction_id",
    "user_profile_id",
    "amount_paid",
    "purchase_date"
  ]
}