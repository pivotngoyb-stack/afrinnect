{
  "name": "Referral",
  "type": "object",
  "properties": {
    "referrer_id": {
      "type": "string",
      "description": "ID of the user who referred"
    },
    "referred_id": {
      "type": "string",
      "description": "ID of the user who was referred"
    },
    "referred_email": {
      "type": "string",
      "description": "Email of the referred user"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed"
      ],
      "default": "pending",
      "description": "Status of the referral"
    },
    "reward_given": {
      "type": "boolean",
      "default": false,
      "description": "Whether reward has been given to referrer"
    },
    "reward_claimed": {
      "type": "boolean",
      "default": false,
      "description": "Whether reward has been claimed by referred user"
    }
  },
  "required": [
    "referrer_id",
    "referred_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "referrer_id": "{{user.id}}"
        },
        {
          "referred_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "referrer_id": "{{user.id}}"
        },
        {
          "referred_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}