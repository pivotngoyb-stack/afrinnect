{
  "name": "SafetyCheck",
  "type": "object",
  "properties": {
    "user_profile_id": {
      "type": "string",
      "description": "User initiating safety check",
      "indexed": true
    },
    "date_location": {
      "type": "string",
      "description": "Where and when meeting"
    },
    "meeting_with_profile_id": {
      "type": "string",
      "description": "Who they're meeting",
      "indexed": true
    },
    "emergency_contact_name": {
      "type": "string",
      "description": "Emergency contact name"
    },
    "emergency_contact_phone": {
      "type": "string",
      "description": "Emergency contact phone"
    },
    "check_in_time": {
      "type": "string",
      "format": "date-time",
      "description": "When to check in",
      "indexed": true
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "checked_in",
        "alert_triggered",
        "completed"
      ],
      "description": "Safety check status",
      "indexed": true
    },
    "panic_location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      },
      "description": "Location when panic button was triggered"
    },
    "moderator_notes": {
      "type": "string",
      "description": "Notes added by admin"
    }
  },
  "required": [
    "user_profile_id",
    "meeting_with_profile_id"
  ],
  "rls": {
    "create": {
      "user_profile_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "user_profile_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_profile_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_profile_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}