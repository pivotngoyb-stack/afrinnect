{
  "name": "SystemSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Setting key identifier",
      "indexed": true,
      "unique": true
    },
    "value": {
      "type": "object",
      "description": "Setting value (JSON object)"
    },
    "description": {
      "type": "string",
      "description": "Human readable description"
    },
    "updated_by": {
      "type": "string",
      "description": "Admin who last updated"
    }
  },
  "required": [
    "key",
    "value"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}