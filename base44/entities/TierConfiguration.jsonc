{
  "name": "TierConfiguration",
  "type": "object",
  "properties": {
    "tier_id": {
      "type": "string",
      "enum": [
        "free",
        "premium",
        "elite",
        "vip"
      ],
      "description": "Subscription tier identifier",
      "indexed": true,
      "unique": true
    },
    "display_name": {
      "type": "string",
      "description": "Display name for the tier"
    },
    "description": {
      "type": "string",
      "description": "Short description of the tier"
    },
    "color": {
      "type": "string",
      "description": "Theme color for the tier (hex or tailwind class)"
    },
    "icon": {
      "type": "string",
      "description": "Icon name from lucide-react"
    },
    "is_popular": {
      "type": "boolean",
      "default": false,
      "description": "Show 'Most Popular' badge"
    },
    "limits": {
      "type": "object",
      "properties": {
        "daily_likes": {
          "type": "number",
          "description": "-1 for unlimited"
        },
        "daily_messages": {
          "type": "number",
          "description": "-1 for unlimited"
        },
        "daily_rewinds": {
          "type": "number",
          "description": "-1 for unlimited"
        },
        "daily_super_likes": {
          "type": "number",
          "description": "-1 for unlimited"
        },
        "monthly_boosts": {
          "type": "number",
          "description": "-1 for unlimited"
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "tooltip": {
            "type": "string"
          }
        }
      },
      "description": "List of features with enabled status"
    },
    "pricing": {
      "type": "object",
      "properties": {
        "monthly": {
          "type": "number"
        },
        "quarterly": {
          "type": "number"
        },
        "yearly": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "default": "USD"
        }
      }
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order in pricing page"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this tier is available for purchase"
    }
  },
  "required": [
    "tier_id",
    "display_name",
    "limits"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}