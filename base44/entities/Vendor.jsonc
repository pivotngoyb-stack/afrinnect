{
  "name": "Vendor",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the vendor"
    },
    "category": {
      "type": "string",
      "enum": [
        "Food & Catering",
        "Photography & Video",
        "Event Planning",
        "Venue",
        "Music & Entertainment",
        "Beauty & Styling",
        "Fashion & Attire",
        "Decor & Flowers",
        "Transportation",
        "Rentals & Equipment",
        "Professional Services",
        "Health & Wellness",
        "Education & Training",
        "Home Services",
        "Other"
      ],
      "description": "Category of service provided"
    },
    "location": {
      "type": "string",
      "description": "Geographic location or service area"
    },
    "state": {
      "type": "string",
      "description": "US State or Canadian Province"
    },
    "country": {
      "type": "string",
      "enum": [
        "USA",
        "Canada"
      ],
      "description": "Country"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Contact email address"
    },
    "website": {
      "type": "string",
      "format": "url",
      "description": "Vendor website URL"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of services"
    },
    "image_url": {
      "type": "string",
      "format": "url",
      "description": "URL to vendor's main image/logo"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Whether the vendor is featured in the marketplace"
    },
    "contact_person": {
      "type": "string",
      "description": "Name of the primary contact person"
    },
    "specialties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Special services or specializations"
    }
  },
  "required": [
    "name",
    "category",
    "location",
    "country",
    "email"
  ]
}