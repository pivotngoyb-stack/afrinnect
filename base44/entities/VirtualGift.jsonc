{
  "name": "VirtualGift",
  "type": "object",
  "properties": {
    "sender_profile_id": {
      "type": "string",
      "description": "Profile ID of gift sender"
    },
    "receiver_profile_id": {
      "type": "string",
      "description": "Profile ID of gift receiver"
    },
    "match_id": {
      "type": "string",
      "description": "Reference to match"
    },
    "gift_type": {
      "type": "string",
      "description": "Type of gift (rose, diamond, chocolate, etc.)"
    },
    "gift_emoji": {
      "type": "string",
      "description": "Emoji representation"
    },
    "message": {
      "type": "string",
      "description": "Optional message with gift"
    },
    "cost": {
      "type": "number",
      "description": "Cost in virtual currency",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "received",
        "viewed"
      ],
      "default": "sent",
      "description": "Gift status"
    }
  },
  "required": [
    "sender_profile_id",
    "receiver_profile_id",
    "gift_type",
    "gift_emoji"
  ],
  "rls": {
    "create": {
      "sender_profile_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "sender_profile_id": "{{user.id}}"
        },
        {
          "receiver_profile_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}